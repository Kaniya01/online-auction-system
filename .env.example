# Local development defaults. Copy this file to .env and set your PostgreSQL
# credentials. For production, set DEBUG=False and replace every secret/host.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_NAME=online_auction
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
# Optional: Render PostgreSQL connection string takes precedence over DB_*.
DATABASE_URL=

# Local email uses the console backend. Configure SMTP variables on Render.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=AuctionHub <noreply@localhost>
SITE_BASE_URL=http://localhost:8000

# Local development continues to store uploads under MEDIA_ROOT (default: ./media).
# Production uses Cloudinary; set these in Render, not in source control.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
# Optional local media root override:
# MEDIA_ROOT=/path/to/local/media

# Razorpay Test Mode values for local/staging only. Never commit real keys.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-signing-secret
RAZORPAY_CURRENCY=INR

# Production HTTPS options are enabled automatically when DJANGO_DEBUG=False.
# Override them only for a known deployment topology.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_USE_HTTPS_PROXY_HEADER=True
